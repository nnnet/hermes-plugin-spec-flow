# spec-flow config FLOOR — the default layer (replaces live-run.env.sh).
#
# Resolution order: case `workers:` block > exported env var > THIS file.
# No literal defaults live in *.py; they live here. A case YAML overrides any
# of these; a real exported env var overrides the file (loaded via setdefault).
# Live-run-specific values (openai backend, bifrost url, gpt-oss model, larger
# tree budget) belong in the case `workers:` block, which wins over this floor.

# ── LLM transport ────────────────────────────────────────────────────────────
SPEC_FLOW_LLM_BACKEND=claude
SPEC_FLOW_LLM_BASE_URL=http://127.0.0.1:8080/v1
SPEC_FLOW_LLM_API_KEY=
SPEC_FLOW_LLM_MODEL=openrouter/qwen/qwen3-coder:free
SPEC_FLOW_LLM_RETRIES=3
SPEC_FLOW_LLM_BACKOFF=5
SPEC_FLOW_LLM_TIMEOUT=300
SPEC_FLOW_ALLOW_PAID=
SPEC_FLOW_FALLBACK_MODEL=haiku
SPEC_FLOW_FALLBACK_COOLDOWN=600
SPEC_FLOW_LLM_CONCURRENCY=0
SPEC_FLOW_LLM_BUDGET=0

# ── per-role model overrides (fall back to SPEC_FLOW_LLM_MODEL when unset) ─────
SPEC_FLOW_DECOMPOSER_MODEL=haiku
SPEC_FLOW_IMPLEMENTER_MODEL=haiku
SPEC_FLOW_JUDGE_MODEL=haiku

# ── tree shaping ─────────────────────────────────────────────────────────────
SPEC_FLOW_LLM_LEAF_DEPTH=3
SPEC_FLOW_LLM_MAX_CHILDREN=4
SPEC_FLOW_DECOMPOSE_ATTEMPTS=3
SPEC_FLOW_IMPL_ATTEMPTS=3
SPEC_FLOW_MAX_DECOMPOSE_CALLS=80
SPEC_FLOW_CREATOR_ENSEMBLE=1

# ── verification ─────────────────────────────────────────────────────────────
SPEC_FLOW_PYTEST_TIMEOUT=180
SPEC_FLOW_INTEGRATE_MAX_REPAIR=2
SPEC_FLOW_INLINE_FILE_LIMIT=8000
SPEC_FLOW_BISECT=1
SPEC_FLOW_BISECT_MAX_FILES=16
SPEC_FLOW_FLAKY_RERUNS=0

# ── role worker ──────────────────────────────────────────────────────────────
SPEC_FLOW_WORKER_TIMEOUT=600
SPEC_FLOW_WORKER_RETRIES=2

# ── HITL ─────────────────────────────────────────────────────────────────────
SPEC_FLOW_HITL_TIMEOUT=120
SPEC_FLOW_HITL_ASK_TIMEOUT=300

# ── memory ───────────────────────────────────────────────────────────────────
SPEC_FLOW_HINDSIGHT_URL=http://127.0.0.1:8888

# ── run log ──────────────────────────────────────────────────────────────────
SPEC_FLOW_RUN_VERBOSITY=2
SPEC_FLOW_RUN_LOG_FORMAT=jsonl

# ── gateway (run_cases) ──────────────────────────────────────────────────────
SPEC_FLOW_BIFROST_URL=http://127.0.0.1:8080/anthropic

# --- Doctor control-loop floors (cause-diagnosis + remedy ladder) ---
SPEC_FLOW_DOCTOR_RING=6
SPEC_FLOW_DOCTOR_NODE_ATTEMPTS=6
SPEC_FLOW_DOCTOR_NONSHRINK=2
SPEC_FLOW_DOCTOR_LEVELS=4
SPEC_FLOW_DOCTOR_ATTEMPTS_PER_LEVEL=2

# --- Prevention: low default worker temperature + configurable leaf thresholds ---
SPEC_FLOW_WORKER_TEMPERATURE=0.1
SPEC_FLOW_LEAF_MAX_MODULES=1
SPEC_FLOW_LEAF_MAX_TASKS=5
SPEC_FLOW_LEAF_MAX_INTERFACES=2
SPEC_FLOW_LEAF_MAX_LOC=100
